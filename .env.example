# Copy to .env for local development and replace the placeholder with a generated key.
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional SMTP configuration
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Optional custom admin login (leave empty to disable this login)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
